rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /projects/{projectId} {
      // Portfolio dapat dibaca publik.
      allow read: if true;
      // Hanya akun admin yang boleh menambah, mengubah, atau menghapus proyek.
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == 'mendinuswandik918@gmail.com';
    }
  }
}
